{
  "name": "@apiaddicts/mcps-style-guide",
  "version": "1.0.0",
  "description": "Spectral ruleset for MCP (Model Context Protocol) tool definitions by APIAddicts / ApiQuality",
  "main": "mcp-ruleset.yaml",
  "files": [
    "mcp-ruleset.yaml",
    "functions/"
  ],
  "scripts": {
    "test": "jest --coverage --detectOpenHandles --no-cache --forceExit",
    "make-badges": "coverage-badges",
    "lint:example": "spectral lint -r mcp-ruleset.yaml examples/valid.json"
  },
  "keywords": [
    "spectral",
    "linter",
    "mcp",
    "model-context-protocol",
    "apiaddicts",
    "apiquality"
  ],
  "author": {
    "name": "APIQuality"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/apiaddicts/mcps-style-guide"
  },
  "devDependencies": {
    "@stoplight/spectral-core": "^1.19.5",
    "@stoplight/spectral-functions": "^1.9.0",
    "@stoplight/spectral-parsers": "^1.0.5",
    "@stoplight/spectral-ruleset-migrator": "^1.10.0",
    "@stoplight/spectral-rulesets": "^1.20.2",
    "@types/jest": "^29.5.14",
    "coverage-badges-cli": "^2.2.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "functions/*.js"
    ],
    "coverageThreshold": {
      "./functions/*.js": {
        "statements": 0
      }
    },
    "coverageReporters": [
      "lcov",
      "json-summary"
    ]
  }
}
